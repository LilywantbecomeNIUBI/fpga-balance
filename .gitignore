.venv/
__pycache__/
*.pyc
balance/build/
balance/results/
motor_control/build/
motor_control/ip/
*.out
*.vcd
*.fs
*.bin
dist/
*.zip
.env

# Publish the current manual release; keep local historical releases/logs.
/releases/*
!/releases/MOTOR_MANUAL_20261028_R4/
/releases/**/results/
/releases/**/build/
/releases/**/motor_control/ip/
!/releases/MOTOR_MANUAL_20261028_R4/firmware/*.fs
/docs/debug.log
/evidence/engineering/pd_observation_poll.stop

!/releases/MOTOR_MANUAL_20261028_R5/
!/releases/MOTOR_MANUAL_20261028_R5/firmware/*.fs

# Local rollback bitstreams are not release deliverables.
/releases/MOTOR_MANUAL_20261028_R5/firmware/previous_*.fs
