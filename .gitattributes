# Hash manifests describe exact bytes; preserve them on Windows/Linux clones.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.png binary
*.whl binary
# Original signed timing reports contain tool-generated trailing spaces.
evidence/builds/*.tr -diff -whitespace

# FPGA bitstreams are release binaries, not reviewable text.
*.fs binary
*.jpg binary

# Preserve original programmer progress output verbatim.
evidence/engineering/*programmer*.log -whitespace
